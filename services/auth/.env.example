# Copy to .env for local runs (never commit .env). Compose and Kubernetes inject these instead.
DATABASE_URL=postgresql+asyncpg://auth:auth@localhost:5433/auth
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
OTP_TTL_SECONDS=300
LOG_LEVEL=INFO
